{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-test.local/schemas/test-case-ir.schema.json",
  "title": "Auto-Test Test Suite IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "suiteId", "source", "target", "policy", "cases"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "suiteId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "fileName", "sha256"],
      "properties": {
        "format": {
          "const": "xlsx"
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "sheetName": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "allowedOrigins"],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "authProfile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseTimeoutMs", "retries", "repair", "destructiveActions"],
      "properties": {
        "caseTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "allowedChanges", "assertionMutation"],
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "allowedChanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["locator", "waitCondition"]
              }
            },
            "assertionMutation": {
              "const": "forbidden"
            }
          }
        },
        "destructiveActions": {
          "enum": ["blocked", "requireApproval"]
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "risk",
        "steps",
        "assertions",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "modulePath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "risk": {
          "enum": ["read", "write", "destructive"]
        },
        "authProfile": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dataBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataBinding"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "cleanupSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "sourceRow": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dataBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["literal", "secret", "generated"]
        },
        "value": {
          "type": ["string", "number", "boolean"]
        },
        "secretRef": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "secret"
              }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["secretRef"]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "generated"
              }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["generator"]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "literal"
              }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["value"]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "targetDescription", "sourceText", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "navigate",
            "click",
            "fill",
            "select",
            "check",
            "uncheck",
            "press",
            "upload",
            "wait_for",
            "manual"
          ]
        },
        "targetDescription": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "valueRef": {
          "type": "string"
        },
        "literalValue": {
          "type": ["string", "number", "boolean"]
        },
        "waitFor": {
          "$ref": "#/$defs/waitCondition"
        },
        "sourceText": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value", "source"],
      "properties": {
        "strategy": {
          "enum": ["role", "testId", "label", "placeholder", "text", "css", "xpath"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "exact": {
          "type": "boolean"
        },
        "source": {
          "enum": ["manual", "playwrightCli", "aiSuggested"]
        }
      }
    },
    "waitCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["visible", "hidden", "attached", "detached", "url", "response"]
        },
        "expected": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "operator",
        "expected",
        "sourceText",
        "oracleSource",
        "immutable",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["visible", "hidden", "text", "url", "title", "value", "count", "enabled", "checked"]
        },
        "targetDescription": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "operator": {
          "enum": ["equals", "contains", "matches", "gt", "gte", "lt", "lte"]
        },
        "expected": {
          "type": ["string", "number", "boolean"]
        },
        "sourceText": {
          "type": "string",
          "minLength": 1
        },
        "oracleSource": {
          "enum": ["tester", "approvedManualEdit"]
        },
        "immutable": {
          "const": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ambiguities", "confidence"],
      "properties": {
        "status": {
          "enum": ["draft", "approved", "rejected"]
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
