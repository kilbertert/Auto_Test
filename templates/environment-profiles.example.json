{
  "version": "1.0",
  "profiles": [
    {
      "id": "staging-example",
      "origins": [
        "https://app.example.test",
        "https://admin.example.test"
      ],
      "secretVaultPath": "/private/staging-secrets.json",
      "plannerContextPath": "/private/staging-planner-context.txt",
      "auth": [
        {
          "origin": "https://admin.example.test",
          "storageStatePath": "/private/admin.storage-state.json",
          "sessionStoragePath": "/private/admin.session-storage.json",
          "login": {
            "loginUrl": "https://admin.example.test/login?redirect=/index",
            "successPathname": "/index",
            "usernameSecretRef": "staging.admin.username",
            "passwordSecretRef": "staging.admin.password",
            "usernameLocator": { "strategy": "label", "value": "Username", "source": "manual" },
            "passwordLocator": { "strategy": "label", "value": "Password", "source": "manual" },
            "submitLocator": { "strategy": "role", "value": "button", "name": "Sign in", "exact": true, "source": "manual" }
          }
        }
      ],
      "policy": {
        "allowWrite": false,
        "allowDestructive": false,
        "maxRefinements": 3,
        "maxEnvironmentRetries": 2
      }
    }
  ]
}
